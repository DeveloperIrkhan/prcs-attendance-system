# Copy to .env and fill in real values. Never commit .env, and never put a real
# password in this file: the repository is public.

# PostgreSQL connection string used by Prisma (app, migrations and seed).
# Neon: copy the pooled connection string from the Neon dashboard.
#DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Local PostgreSQL:
#DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/attendance_db?schema=public"

# Signs the session cookie. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Initial Admin account created by `npm run db:seed`.
# The password here is only used when the account is first created, unless you also
# set SEED_RESET_ADMIN_PASSWORD=true, which overwrites the existing password.
SEED_ADMIN_NAME="System Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-before-first-run"
SEED_ADMIN_MUST_CHANGE_PASSWORD="true"
SEED_RESET_ADMIN_PASSWORD="false"

# ZKTeco device poller (`npm run sync`). Run it on the office computer: a hosted
# deployment such as Vercel cannot reach devices on the office LAN.
#
# One or more devices, as a JSON list. The optional `id` is the heartbeat name shown on
# the dashboard; it defaults to device-<last IP octet>. `port` defaults to 4370 and
# `commKey` to 0. Keep the ids stable: they are part of each punch's dedupe key.
#ZK_DEVICES='[
#  {"id":"gate-left","ip":"192.168.1.101","port":4370,"commKey":0},
#  {"id":"gate-right","ip":"192.168.1.102","port":4370,"commKey":0}
#]'

# Single-device form, used only when ZK_DEVICES is not set.
ZK_DEVICE_ID="uface800-main"
ZK_DEVICE_IP="192.168.1.100"
ZK_DEVICE_PORT="4370"
ZK_COMM_KEY="0"

# How often the poller reads the devices.
ZK_POLL_INTERVAL_MS="60000"
# "local" trusts the device clock, "utc" shifts by the office timezone.
ZK_TIME_MODE="local"

# Attendance date handling. Leave empty to use the server's local timezone.
OFFICE_TIMEZONE="Asia/Karachi"

# Production only: set to "false" when the site is served over plain HTTP (office LAN),
# so the session cookie is not marked Secure. Defaults to true in production.
# COOKIE_SECURE="false"

# Send HSTS only when the site is actually served over HTTPS.
ENABLE_HSTS="false"

# Device heartbeat indicator on the dashboard: "on" / "off" / "auto" (default).
# On a hosted deployment the badge reports the age of the synced data instead of
# claiming the device is unreachable from there.
# SYNC_HEALTH_MODE="auto"
