# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma (app, migrations and seed).
#DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/attendance_db?schema=public"
DATABASE_URL="postgresql://neondb_owner:npg_tJPoD8m3BeEY@ep-calm-cell-b4yewe1c-pooler.c-6.us-east-2.aws.neon.tech/Ihra_attendance_system?sslmode=require&channel_binding=require"

# Signs the session cookie. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Initial Admin account created by `npm run db:seed`.
# The password here is only used when the account is first created, unless you also
# set SEED_RESET_ADMIN_PASSWORD=true, which overwrites the existing password.
SEED_ADMIN_NAME="System Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-before-first-run"
SEED_RESET_ADMIN_PASSWORD="false"
SEED_ADMIN_MUST_CHANGE_PASSWORD="true"

# ZKTeco device poller (run with `npm run sync`).
ZK_DEVICE_ID="uface800-main"
ZK_DEVICE_IP="192.168.1.100"
ZK_DEVICE_PORT="4370"
ZK_POLL_INTERVAL_MS="60000"
ZK_COMM_KEY="0"
# "local" trusts the device clock, "utc" shifts by the office timezone.
ZK_TIME_MODE="local"

# Attendance date handling. Leave empty to use the server's local timezone.
OFFICE_TIMEZONE="Asia/Karachi"

# Production only: set to "false" when the site is served over plain HTTP (office LAN),
# so the session cookie is not marked Secure. Defaults to true in production.
# COOKIE_SECURE="false"

# Send HSTS only when the site is actually served over HTTPS.
ENABLE_HSTS="false"

# Device heartbeat indicator on the dashboard: "on" / "off" / "auto" (default).
# SYNC_HEALTH_MODE="auto"
